# Copy to infra/.env (production) or infra/.env.staging (pre-production).
# Never committed.

# Names the Docker project, which namespaces containers, network and volume.
# Staging and production must differ, or they would share a database.
COMPOSE_PROJECT_NAME=menu

# Where the built front-end is published, for Apache to serve.
WEB_ROOT=/var/www/menu

# --- Database -----------------------------------------------------------
POSTGRES_DB=menu
POSTGRES_USER=menu
POSTGRES_PASSWORD=change-me

# Local development only. In production the API container builds this itself
# from the values above and reaches the database over the Docker network.
DATABASE_URL=postgres://menu:change-me@localhost:5432/menu

# --- API ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Host port the API is published on, bound to 127.0.0.1 only. Change it if
# something else on the server already uses 3000 — and update the ProxyPass
# lines in infra/apache/menu.conf to match.
API_PORT=3000

# Signs access and refresh tokens. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Public origin of the site (cookie scope, redirect building).
# In production: https://menu.sukaxess.com
PUBLIC_ORIGIN=http://localhost:8080

# --- Payment ------------------------------------------------------------
# `manual`    : an administrator confirms each payment in the back office.
# `wave_link` : redirects to a static Wave merchant link. The return URL is
#               NOT trusted, so the order still needs manual confirmation.
# `cinetpay`  : mobile money aggregator. Payments settle on their own, from a
#               server-to-server check — never from the callback's contents.
PAYMENT_PROVIDER=manual

WAVE_PAYMENT_URL=https://pay.wave.com/m/M_sn_e0AALi3GMxex/c/sn/

# CinetPay. Secrets: this file is never committed.
# Dashboard → Intégrations. The secret key signs the x-token on notifications
# and is a different credential from the API key.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

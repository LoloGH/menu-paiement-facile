# drizzle-orm declares optional peer dependencies on React Native, Expo and
# op-sqlite. None apply here, but npm still evaluates them when the package is
# hoisted next to the web app's React 18, which fails resolution and pushes
# drizzle-orm into apps/api/node_modules — where the hoisted drizzle-kit CLI
# can no longer find it.
#
# Peer ranges are still visible via `npm ls`; real conflicts (such as the
# date-fns / react-day-picker one) are fixed in package.json, not hidden here.
legacy-peer-deps=true
